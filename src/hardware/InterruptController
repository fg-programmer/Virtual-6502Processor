import { Hardware } from './Hardware';
class InterruptController extends Hardware {
    private devices: Interrupt[] = []; // Registered interrupt-generating devices
    private interruptQueue: Interrupt[] = []; // Active interrupts waiting to be processed

    constructor(id: number, name: string) {
        super(id, name);
    }



    // Register an interrupt-generating device
    registerDevice(device: Interrupt): void {
        this.devices.push(device);
        this.log(`Device registered: ${device.deviceName} (IRQ: ${device.irqNum}, Priority: ${device.priority})`);
    }    
        // Add an interrupt to the queue
        addInterrupt(device: Interrupt): void {
            this.interruptQueue.push(device);
            this.interruptQueue.sort((a, b) => a.priority - b.priority);
            this.log(`Interrupt added: ${device.deviceName} (IRQ: ${device.irqNum})`);
        }
    
        // Provide the highest-priority interrupt to the CPU
        getNextInterrupt(): Interrupt | undefined {
            return this.interruptQueue.shift(); 
        }
    
        // Simulate handling interrupts each clock cycle
        clockCycle(): void {
            if (this.interruptQueue.length > 0) {
                const interrupt = this.getNextInterrupt();
                if (interrupt) {
                    this.log(`Handling interrupt: ${interrupt.deviceName} (IRQ: ${interrupt.irqNum})`);
                }
            } else {
                this.log("No interrupts to handle");
            }
        }
    }
